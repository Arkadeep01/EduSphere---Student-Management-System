# =============================================================================
# EduSphere Environment Configuration
# =============================================================================
# Copy this file to .env and fill in values for your environment.
# Production: supply all SECRET_KEY, DATABASE_URL, OAuth, S3, and Email vars.
# Development: most defaults work out of the box with Docker Compose.
# =============================================================================

# ===== REQUIRED (no safe defaults) =====
# Generate with: openssl rand -hex 64
SECRET_KEY=

# ===== Database (PostgreSQL) =====
# In Docker Compose, individual fields are auto-injected so DATABASE_URL is
# optional. Outside Docker, set DATABASE_URL or the individual fields below.
# DATABASE_URL=postgres://user:password@host:port/dbname?sslmode=require
# OR individual fields (used when DATABASE_URL is not set):
# DATABASE_NAME=edusphere
# DATABASE_USER=edusphere
# DATABASE_PASSWORD=edusphere
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# SSL_MODE=require

# ===== Django =====
DEBUG=TRUE
# Comma-separated lists
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
FRONTEND_URL=http://localhost:5173

# ===== HTTPS / Security (set for Docker production behind TLS termination) =====
# SECURE_SSL_REDIRECT=TRUE
# SESSION_COOKIE_SECURE=TRUE
# CSRF_COOKIE_SECURE=TRUE
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=TRUE
# SECURE_HSTS_PRELOAD=FALSE

# ===== OAuth (required for social login) =====
# OAuth credentials are stored in Django admin SocialApp model (DB-backed).
# These env vars are informational placeholders for documentation purposes.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ===== Email (Resend) =====
# RESEND_API_KEY=
# EMAIL_FROM=noreply@yourdomain.com
# EMAIL_FROM_NAME=EduSphere

# ===== S3-compatible object storage (production media) =====
# USE_S3=FALSE → local FileSystemStorage (development, no S3 credentials needed)
# USE_S3=TRUE  → S3Boto3Storage (requires credentials below)
# USE_S3=FALSE
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_ENDPOINT_URL=
# AWS_S3_CUSTOM_DOMAIN=
# AWS_DEFAULT_ACL=public-read
# AWS_QUERYSTRING_AUTH=FALSE

# ===== Redis (auto-detected; falls back to in-memory if unavailable) =====
# REDIS_URL=redis://redis:6379/0

# ===== Logging =====
# DJANGO_LOG_LEVEL=INFO

# ===== JWT Tokens =====
# ACCESS_TOKEN_LIFETIME=15   # minutes
# REFRESH_TOKEN_LIFETIME=7   # days

# ===== File Upload =====
# MAX_UPLOAD_SIZE_MB=20
